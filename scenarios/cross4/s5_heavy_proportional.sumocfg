<?xml version="1.0" encoding="UTF-8"?>
<!-- Run with: sumo -c s5_heavy_proportional.sumocfg   (outputs go to output/s5_heavy_proportional_*.xml) -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="cross4.net.xml"/>
        <route-files value="demand_heavy.rou.xml"/>
        <additional-files value="tlLogic_proportional.add.xml,detectors.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
    </time>
    <random_number>
        <seed value="42"/>
    </random_number>
    <processing>
        <time-to-teleport value="-1"/> <!-- never teleport stuck cars; they would hide congestion -->
    </processing>
    <output>
        <output-prefix value="output/s5_heavy_proportional_"/>
        <tripinfo-output value="tripinfo.xml"/>
        <tripinfo-output.write-unfinished value="true"/> <!-- otherwise cars still queued at the end are silently dropped -->
        <summary-output value="summary.xml"/>
        <queue-output value="queue.xml"/>
    </output>
    <report>
        <no-step-log value="true"/>
    </report>
</sumoConfiguration>
