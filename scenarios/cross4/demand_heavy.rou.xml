<?xml version="1.0" encoding="UTF-8"?>
<!-- heavy demand: main 1200 veh/h per lane, minor 400 veh/h per lane, for 1 hour.
     period="exp(rate)" gives random (Poisson) arrivals, rate in veh/s. -->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="main" vClass="passenger" color="1,0,0"/>
    <vType id="minor" vClass="passenger" color="1,1,0"/>
    <flow id="NS" type="main" begin="0" end="3600" period="exp(0.333333)" from="N_in" to="S_out" departLane="best" departSpeed="max"/>
    <flow id="SN" type="main" begin="0" end="3600" period="exp(0.333333)" from="S_in" to="N_out" departLane="best" departSpeed="max"/>
    <flow id="EW" type="minor" begin="0" end="3600" period="exp(0.111111)" from="E_in" to="W_out" departLane="best" departSpeed="max"/>
    <flow id="WE" type="minor" begin="0" end="3600" period="exp(0.111111)" from="W_in" to="E_out" departLane="best" departSpeed="max"/>
</routes>
