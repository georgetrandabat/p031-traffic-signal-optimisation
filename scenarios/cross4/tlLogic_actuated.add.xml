<?xml version="1.0" encoding="UTF-8"?>
<!-- Actuated (gap-based): no fixed cycle. Each green lasts 10-50 s and ends early once no car
     crosses the detector loop for 3 s (max-gap). Cycle varies from 30 s to 110 s.
     Each phase loses ~5 s (3 s yellow + 2 s all-red), so effective green ~= displayed green.
     State string link order: N_in, E_in, S_in, W_in. -->
<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">
    <tlLogic id="C" type="actuated" programID="actuated" offset="0">
        <param key="max-gap" value="3"/>
        <param key="show-detectors" value="true"/>
        <phase minDur="10" maxDur="50" duration="34" state="rGrG"/> <!-- main (E-W) green -->
        <phase duration="3"  state="ryry"/>
        <phase duration="2"  state="rrrr"/>
        <phase minDur="10" maxDur="50" duration="16" state="GrGr"/> <!-- minor (N-S) green -->
        <phase duration="3"  state="yryr"/>
        <phase duration="2"  state="rrrr"/>
    </tlLogic>
</additional>
